# --- Database (Supabase) ---------------------------------------------------
# App connection: Supabase "Transaction pooler" (port 6543). Required on Vercel (serverless).
# Supabase certs aren't in Node's trust store, so use sslmode=no-verify (encrypted, not CA-verified).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=no-verify"
# Migrations: "Session pooler" (port 5432, IPv4-friendly) or the direct connection. Optional locally.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# Local Docker alternative:
# DATABASE_URL="postgresql://betweenus:betweenus@localhost:54329/betweenus"

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin: http://localhost:3000 locally, your production URL on Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# --- Provisioning (optional; `npm run provision` only) ----------------------
# Leave empty to get random passwords printed once. Set to choose your own.
MARTINHA_PASSWORD=""
RICARDO_PASSWORD=""
SPACE_NAME="Between Us"
